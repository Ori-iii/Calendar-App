<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="calender.GroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:calender"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumnSpace" Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Header + Add Event Button -->
        <Grid Grid.Row="0" ColumnSpacing="8" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="AddEventButton"
                    Grid.Column="1"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="AddMembersButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="Add Members" />
                </StackPanel>
            </Button>
            <Button x:Name="AddGroupButton"
                Grid.Column="2"
                Style="{ThemeResource AccentButtonStyle}"
                Click="AddGroupButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="Add Group" />
                </StackPanel>
            </Button>
            <Button x:Name="deleteGroupButton"
                Grid.Column="3"
                Style="{ThemeResource AccentButtonStyle}"
                Click="deleteGroup_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    <TextBlock Text="Delete Group" />
                </StackPanel>
            </Button>
            <Button x:Name="leaveGroupButton"
                Grid.Column="4"
                Style="{ThemeResource AccentButtonStyle}"
                Click="leaveGroup_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xF3B1;" FontSize="12" />
                    <TextBlock Text="Leave Group" />
                </StackPanel>
            </Button>
        </Grid>


        <ListView x:Name="GroupListView"
                  Grid.Row="1"
                  Grid.Column="0"
                  HorizontalAlignment="Stretch"
                  SelectionMode="Single"
                  Margin="0,8,0,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:Group">
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="4"
                                CornerRadius="2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind group_name}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind created_at}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="-"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="InfoButton" 
                            Click="Info_Click" 
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="16"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Frame x:Name="RightSideDetailsFrame"
           Visibility="Collapsed" 
           Grid.Row="1"
           Grid.Column="1"
           Margin="24,8,0,0"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"/>
    </Grid>
</Page>
