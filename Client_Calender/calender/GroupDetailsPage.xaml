<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="calender.GroupDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:calender"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,24,0">
        <StackPanel Spacing="24">

            <!-- SECTION 1: Group Header Details -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="GroupNameHeader" 
                           Text="Select a Group" 
                           Style="{ThemeResource TitleTextBlockStyle}" 
                           FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Created on:" 
                               Style="{ThemeResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="GroupCreatedSubtext" 
                               Text="N/A" 
                               Style="{ThemeResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- SECTION 2: Members Panel -->
            <StackPanel Spacing="8">
                <TextBlock Text="Group Members" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Border BorderThickness="1" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        CornerRadius="8" 
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <ListView x:Name="MembersListView" 
                              SelectionMode="Single"
                              MaxHeight="220">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Member">
                                <Grid Padding="12,6" ColumnSpacing="12" HorizontalAlignment="Stretch">

                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Name="kickButton" Text="Kick" Click="KickMember_Click" Tag="{Binding}"/>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Member Info -->
                                    <StackPanel  Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind username}" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind display_name}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    </StackPanel>

                                    <!-- Member Role Badge -->
                                    <Border Grid.Row="0" Grid.Column="1" 
                                            Background="{ThemeResource ControlSolidFillColorDefaultBrush}" 
                                            Padding="8,4" 
                                            CornerRadius="4" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind role}" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <MenuFlyoutSeparator Grid.Row="1" 
                                     Grid.Column="0" 
                                     Grid.ColumnSpan="2" 
                                     Margin="0,10,0,0"
                                     HorizontalAlignment="Stretch" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <!-- SECTION 3: Group Events Panel -->
            <StackPanel Spacing="8">
                <TextBlock Text="Upcoming Group Events" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Border BorderThickness="1" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        CornerRadius="8" 
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <ListView x:Name="EventsListView" 
                              SelectionMode="None" 
                              MaxHeight="260">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Event">
                                <Grid Padding="12,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Timeline icon indicator -->
                                    <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>

                                    <!-- Event Description Block -->
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind title}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind start_time}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="to" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind start_time}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
