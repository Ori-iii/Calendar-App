<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="calender.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:calender"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Calendar App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  TitleBar  -->
            <RowDefinition Height="*" />
            <!--  NavigationView  -->
        </Grid.RowDefinitions>

        <TitleBar Grid.Row="0"
            x:Name="titleBar"
                  Height="32">
            <TitleBar.LeftHeader>
                <TextBlock Text="Calender App" 
                   VerticalAlignment="Center" 
                   Margin="12,0,0,0"
                   FontWeight="Bold" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <NavigationView x:Name="navView" ItemInvoked="NavView_ItemInvoked" IsSettingsVisible="False"
                        Loaded="NavView_Loaded" Grid.Row="1" IsBackButtonVisible="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Calendar" Content="Calendar" Tag="EventsPage" />
                <NavigationViewItem Icon="People" Content="Groups" Tag="GroupsPage" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Accessibility" Tag="AccessibilityPageItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE776;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
                <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Popup x:Name="AccessibilityPopup" IsLightDismissEnabled="True">
            <Border
                    Width="200"
                    Height="200"
                    CornerRadius="12"
                    Padding="16"
                    Translation="0,0,32"
                    BorderThickness="1">

                <!-- popup content goes here -->
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <Frame x:Name="AccessibilityFrame"/>
            </Border>

        </Popup>
    </Grid>
</Window>