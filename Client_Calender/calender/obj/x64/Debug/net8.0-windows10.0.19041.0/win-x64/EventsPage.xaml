<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="calender.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:calender"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Calendar View -->
        <Border Grid.Column="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8"
            Padding="16"
            VerticalAlignment="Top">
            <StackPanel Spacing="16">
                <CalendarView x:ConnectionId='14' x:Name="MyCalendar"
                          SelectionMode="Single"
                          HorizontalAlignment="Center"
                                                                                 
                                                                                              />

                <Border x:ConnectionId='15' x:Name="EventDetailsBorder"
                    Visibility="Collapsed"
                    CornerRadius="8"
                    Padding="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch"
                    Height="220">
                    <Frame x:ConnectionId='16' x:Name="EventDetailsFrame" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Right Column: Events List for Selected Day -->
        <Border Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="16">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header + Add Event Button -->
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:ConnectionId='9' x:Name="SelectedDateHeader"
                               Grid.Column="0"
                               Text="Select a date"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center" />

                    <Button x:ConnectionId='10' x:Name="AddEventButton"
                            Grid.Column="1"
                            Style="{ThemeResource AccentButtonStyle}"
                                                        >
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Add Event" />
                        </StackPanel>
                    </Button>
                    <Button x:ConnectionId='11' x:Name="AddGroupButton"
                        Grid.Column="2"
                        Style="{ThemeResource AccentButtonStyle}"
                                                    >
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Add Group" />
                        </StackPanel>
                    </Button>
                    <Button x:ConnectionId='12' x:Name="DeleteEventButton"
                        Grid.Column="3"
                        Style="{ThemeResource AccentButtonStyle}"
                                                 >
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            <TextBlock Text="Delete Event" />
                        </StackPanel>
                    </Button>
                    <Button x:ConnectionId='13' x:Name="ShareEventButton"
                        Grid.Column="4"
                        Style="{ThemeResource AccentButtonStyle}"
                                                >
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72D;" FontSize="12" />
                            <TextBlock Text="Share Event" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- List of events -->
                <ListView x:ConnectionId='2' x:Name="EventsListView"
                          Grid.Row="1"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate                         >
                            <Grid x:ConnectionId='4' Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="4"
                                        CornerRadius="2"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}" />

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:ConnectionId='6'                      
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:ConnectionId='7'                                       
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="-"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:ConnectionId='8'                                     
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button x:ConnectionId='5' x:Name="InfoButton" 
                                                       
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE946;" FontSize="16"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>

